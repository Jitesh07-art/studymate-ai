# Copy this file to .env and add your provider key.
SECRET_KEY=replace-with-a-random-local-secret
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# Optional: use an OpenAI-compatible provider endpoint.
AI_BASE_URL=
# Set true to use clearly labeled local examples without an API key.
AI_DEMO_MODE=false
# Optional database path; defaults to instance/studymate.db
# DATABASE_PATH=
# Optional: set DATABASE_URL to a PostgreSQL connection URL for persistent hosting.
# DATABASE_URL=
# Configure SMTP to enable password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Set true when serving over HTTPS (recommended for hosted deployments).
SESSION_COOKIE_SECURE=false
